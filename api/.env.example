# ---------------------------------------------------------------
# Local development only. Copy to api/.env and adjust if needed.
# api/.env is git-ignored - never commit real credentials.
#
# On cPanel these same names are set in:
#   Setup Node.js App -> your app -> Environment variables
# ---------------------------------------------------------------

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=charityevents_db

